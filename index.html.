<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>¿Qué pelota sale?</title>
<style>
:root{--ink:#272747;--muted:#686982;--line:#e7e2f0}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;display:grid;place-items:center;padding:20px;background:linear-gradient(135deg,#f5f0ff,#fffdf8 58%,#edf7ff);font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:var(--ink)}
main{width:min(100%,650px);background:#ffffffdf;border:1px solid var(--line);border-radius:28px;padding:clamp(22px,5vw,42px);box-shadow:0 15px 45px #33235a12;text-align:center}
h1{font-size:clamp(1.8rem,5vw,2.7rem);margin:0 0 8px}
p{color:var(--muted);line-height:1.5;margin:0}
.cube{margin:28px auto 20px;width:160px;height:145px;position:relative;display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:8px;padding:24px 16px;background:#eaf4ffb8;border:4px solid #5b6482;border-radius:12px;transform:perspective(500px) rotateY(-7deg);box-shadow:inset 0 0 0 5px #ffffff88,0 10px 0 #d8d5e3}
.ball{width:31px;height:31px;border-radius:50%;border:2px solid #00000017;box-shadow:inset -4px -5px 0 #00000015,inset 3px 3px 0 #ffffff66}
button{border:0;background:#5142a0;color:white;border-radius:15px;padding:14px 25px;font:inherit;font-weight:750;font-size:1.05rem;cursor:pointer;box-shadow:0 5px 0 #352a78;transition:transform .1s}
button:hover{filter:brightness(1.07)}button:active{transform:translateY(3px);box-shadow:0 2px 0 #352a78}
.result{margin:24px auto 10px;min-height:115px;display:flex;align-items:center;justify-content:center;gap:14px;background:#f7f4ff;border:1px solid #e6defb;border-radius:20px;padding:18px}
.result-ball{width:58px;height:58px;border-radius:50%;border:3px solid #00000016;box-shadow:inset -7px -8px 0 #00000013,inset 5px 5px 0 #ffffff77;display:none;flex-shrink:0}
.result-text{font-size:1.35rem;font-weight:800}
.hint{font-size:.9rem;margin-top:12px}
.legend{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin-top:24px}
.item{border-radius:13px;padding:10px 4px;background:var(--tint);font-size:.83rem}
.item .ball{margin:0 auto 6px}
.item strong{display:block}.item small{color:var(--muted)}
@media(max-width:430px){.legend{grid-template-columns:repeat(3,minmax(0,1fr))}.cube{transform:none}}
</style>
</head>
<body>
<main>
 <h1>🎱 ¿Qué pelota sale?</h1>
 <p>Imagina que mezclas las 14 pelotas dentro del cubo y sacas una sin mirar.</p>
 <div class="cube" aria-hidden="true">
  <span class="ball" style="background:#e95757"></span><span class="ball" style="background:#31945d"></span><span class="ball" style="background:#f0bd27"></span><span class="ball" style="background:#3986e8"></span><span class="ball" style="background:#9654c9"></span><span class="ball" style="background:#f0bd27"></span><span class="ball" style="background:#31945d"></span><span class="ball" style="background:#3986e8"></span><span class="ball" style="background:#f0bd27"></span><span class="ball" style="background:#e95757"></span>
 </div>
 <button id="draw">🎲 Sacar una pelota</button>
 <div class="result" aria-live="polite">
  <div class="result-ball" id="resultBall"></div>
  <div class="result-text" id="resultText">Pulsa el botón para empezar</div>
 </div>
 <p class="hint">Cada extracción vuelve a usar las mismas probabilidades. No se guarda ningún resultado.</p>
 <div class="legend">
  <div class="item" style="--tint:#fff0f0"><div class="ball" style="background:#e95757"></div><strong>Roja</strong><small>2 de 14</small></div>
  <div class="item" style="--tint:#eefaf1"><div class="ball" style="background:#31945d"></div><strong>Verde</strong><small>3 de 14</small></div>
  <div class="item" style="--tint:#fff9df"><div class="ball" style="background:#f0bd27"></div><strong>Amarilla</strong><small>4 de 14</small></div>
  <div class="item" style="--tint:#edf5ff"><div class="ball" style="background:#3986e8"></div><strong>Azul</strong><small>3 de 14</small></div>
  <div class="item" style="--tint:#f7efff"><div class="ball" style="background:#9654c9"></div><strong>Morada</strong><small>2 de 14</small></div>
 </div>
</main>
<script>
const balls=[
 {name:'¡Ha salido una pelota ROJA!',color:'#e95757',weight:2},
 {name:'¡Ha salido una pelota VERDE!',color:'#31945d',weight:3},
 {name:'¡Ha salido una pelota AMARILLA!',color:'#f0bd27',weight:4},
 {name:'¡Ha salido una pelota AZUL!',color:'#3986e8',weight:3},
 {name:'¡Ha salido una pelota MORADA!',color:'#9654c9',weight:2}
];
document.getElementById('draw').addEventListener('click',()=>{
 const total=balls.reduce((sum,b)=>sum+b.weight,0);
 let n=Math.random()*total, chosen=balls[balls.length-1];
 for(const b of balls){n-=b.weight;if(n<0){chosen=b;break;}}
 const ball=document.getElementById('resultBall');
 ball.style.background=chosen.color;ball.style.display='block';
 document.getElementById('resultText').textContent=chosen.name;
});
</script>
</body>
</html>
